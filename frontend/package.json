    "@angular/platform-browser-dynamic": "21.2.20",
    "@angular/router": "21.2.20",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.20",
    "@playwright/test": "1.62.1",
    "@types/jasmine": "6.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "10.8.1",
    "jasmine-core": "6.3.0",
    "karma": "6.4.4",
